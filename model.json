{
  "kind": "audio_mixer",
  "version": "0.1.0",
  "title": "Audio Mixer",
  "description": "Mixes multiple Opus sources into one clocked Ogg/Opus stream with source gain and mute.",
  "bloxsmith_compatibility": [
    "1.0.9"
  ],
  "tested_with_bloxsmith": "1.0.9",
  "locales": {
    "en": "locales/en.json",
    "fr": "locales/fr.json"
  },
  "ports": {
    "inputs": [
      {
        "id": 1,
        "name": "audio_in_1",
        "title": "Source 1 audio",
        "accepts": [
          "audio/*"
        ],
        "multiplicity": "one",
        "required": false,
        "execution_requirement": "not_required_for_execution",
        "transport": "audio_stream",
        "audio_stream": {
          "codecs": [
            "opus"
          ],
          "sample_rates_hz": [
            48000
          ],
          "channels": [
            1,
            2
          ],
          "overflow_policy": "disconnect"
        }
      },
      {
        "id": 2,
        "name": "command_in_1",
        "title": "Source 1 cmd",
        "accepts": [
          "application/json"
        ],
        "multiplicity": "one",
        "required": false,
        "execution_requirement": "not_required_for_execution",
        "transport": "message"
      },
      {
        "id": 3,
        "name": "audio_in_2",
        "title": "Source 2 audio",
        "accepts": [
          "audio/*"
        ],
        "multiplicity": "one",
        "required": false,
        "execution_requirement": "not_required_for_execution",
        "transport": "audio_stream",
        "audio_stream": {
          "codecs": [
            "opus"
          ],
          "sample_rates_hz": [
            48000
          ],
          "channels": [
            1,
            2
          ],
          "overflow_policy": "disconnect"
        }
      },
      {
        "id": 4,
        "name": "command_in_2",
        "title": "Source 2 cmd",
        "accepts": [
          "application/json"
        ],
        "multiplicity": "one",
        "required": false,
        "execution_requirement": "not_required_for_execution",
        "transport": "message"
      }
    ],
    "outputs": [
      {
        "id": 1,
        "name": "audio_out",
        "title": "Audio out",
        "emits": [
          "audio/*"
        ],
        "multiplicity": "many",
        "transport": "audio_stream",
        "audio_stream": {
          "codecs": [
            "opus"
          ],
          "sample_rates_hz": [
            48000
          ],
          "channels": [
            1,
            2
          ]
        }
      },
      {
        "id": 2,
        "name": "command_out",
        "title": "Stream cycle",
        "emits": [
          "application/json"
        ],
        "multiplicity": "many",
        "transport": "message"
      }
    ]
  },
  "config": {
    "sources": [
      {
        "id": 1,
        "label": "Source 1",
        "gain_db": 0,
        "muted": false
      },
      {
        "id": 2,
        "label": "Source 2",
        "gain_db": 0,
        "muted": false
      }
    ],
    "drain_timeout_sec": 5,
    "buffer_ms": 150,
    "master_gain_db": -6,
    "channels": 1
  },
  "port_capabilities": {
    "can_add_inputs": true,
    "can_add_outputs": false,
    "allow_required_input": false,
    "default_required": false,
    "max_inputs": 16,
    "max_outputs": 2,
    "default_multiplicity": "one"
  },
  "runtime": {
    "initial_state": "waiting",
    "runtime_executable": true,
    "active_worker": true,
    "centralized_executor": "generic",
    "supports_runtime_audio_streams": true,
    "active_execution_policy": "on_each_event"
  },
  "ui_assets": {
    "modal": [
      {
        "kind": "css",
        "path": "assets/css/properties.css"
      },
      {
        "kind": "js",
        "path": "assets/js/common.js"
      },
      {
        "kind": "js",
        "path": "assets/js/block_modal.js"
      }
    ],
    "inspector_panel": [
      {
        "kind": "css",
        "path": "assets/css/properties.css"
      },
      {
        "kind": "js",
        "path": "assets/js/common.js"
      },
      {
        "kind": "js",
        "path": "assets/js/inspector_panel.js"
      }
    ],
    "node_card": [
      {
        "kind": "css",
        "path": "assets/css/card.css"
      }
    ]
  }
}
